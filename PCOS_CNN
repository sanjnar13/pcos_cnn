   "source": [
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "from sklearn.metrics import accuracy_score, precision_score, recall_score, roc_auc_score\n",
    "from sklearn.model_selection import train_test_split\n",
    "import torch\n",
    "from torch import nn, optim\n",
    "from torch.utils.data import DataLoader, Subset\n",
    "from torchvision import datasets, transforms"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "8369673c",
   "metadata": {},
   "outputs": [],
   "source": [
    "batch_size = 64\n",
    "n_epochs = 5"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "1901e6d7",
   "metadata": {},
   "source": [
    "### Load data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "e339da94",
   "metadata": {},
   "outputs": [],
   "source": [
    "data = datasets.ImageFolder(\n",
    "    root=\"pcos_dataset\",\n",
    "    transform=transforms.Compose([\n",
    "        transforms.ToTensor(),\n",
    "        transforms.Resize((128, 128)),\n",
    "        transforms.Grayscale(num_output_channels=1),\n",
    "        transforms.RandomHorizontalFlip(p=0.5),\n",
    "        transforms.GaussianBlur(kernel_size=3, sigma=(0.1, 1)),\n",
    "        transforms.RandomVerticalFlip(p=0.5),\n",
    "    ]\n",
    "),\n",
    "    \n",
    ")\n",
    "\n",
    "#Split into training and testing subsets\n",
    "train_indices, test_indices = train_test_split(\n",
    "    range(len(data)),\n",
    "    test_size = 0.3,\n",
    "    shuffle=True\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 26,
   "id": "c42d0443",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Classes found: ['infected', 'noninfected']\n",
      "Class to index mapping: {'infected': 0, 'noninfected': 1}\n"
     ]
    }
   ],
   "source": [
    "print(\"Classes found:\", data.classes)\n",
    "print(\"Class to index mapping:\", data.class_to_idx)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 20,
   "id": "2a1aac30",
   "metadata": {},
   "outputs": [],
   "source": [
    "train_data = Subset(data, train_indices)\n",
    "test_data = Subset(data, test_indices)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "78d8db96",
   "metadata": {},
   "outputs": [],
   "source": [
    "#Normalize \n",
    "u=torch.zeros(1) #Grayscale, so 1 channel\n",
    "u2=torch.zeros(1)\n",
    "n=0\n",
    "for image, _ in train_data:\n",
    "    u+=image.mean([1,2])\n",
    "    u2+= (image**2).mean([1,2])\n",
    "    n+=1\n",
    "u/=n\n",
    "u2/=n\n",
    "s=(u2-u**2).sqrt()\n",
    "\n",
    "normalization = transforms.Normalize(u.tolist(), s.tolist())\n",
    "data.transform.transforms.append(normalization)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "36b72413",
   "metadata": {},
   "source": [
    "## Create DataLoaders"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "aa2c7462",
   "metadata": {},
   "outputs": [],
   "source": [
    "train_loader=DataLoader(\n",
    "    train_data,\n",
    "    batch_size = batch_size,\n",
    "    shuffle=True \n",
    ")\n",
    "\n",
    "test_loader=DataLoader(\n",
    "    test_data,\n",
    "    batch_size = batch_size,\n",
    "    shuffle=True \n",
    ")"
   ]
  },
